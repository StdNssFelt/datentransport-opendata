name: Fetch Senseering Data (LAeq)

on:
  schedule:
    # Läuft alle 15 Minuten vollautomatisch
    - cron: '*/15 * * * *'
  workflow_dispatch: # Erlaubt manuelles Starten per Klick

jobs:
  fetch:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - name: Repository auschecken
        uses: actions/checkout@v4

      - name: Python einrichten
        uses: actions/setup-python@v5
        with:
          python-version: '3.x'

      - name: Lautstärkeäquivalente (LAeq) von Senseering abfragen
        env:
          AUTH_HEADER: ${{ secrets.AUTH_HEADER }}
        run: |
          # Berechnet dynamisch Start- und Endzeitpunkt (letzte 14 Tage)
          FROM_DATE=$(date -u -d '14 days ago' +'%Y-%m-%dT%H:%M:%SZ')
          UNTIL_DATE=$(date -u +'%Y-%m-%dT%H:%M:%SZ')

          # Payload ausschließlich mit den LAeq-PropertyIDs
          cat <<EOF > payload.json
          {
            "queries": [
              { "source": { "property_id": 141830 }, "time": { "from": "$FROM_DATE", "until": "$UNTIL_DATE" }, "resolution": { "value": 15, "unit": "MINUTES" } },
              { "source": { "property_id": 141835 }, "time": { "from": "$FROM_DATE", "until": "$UNTIL_DATE" }, "resolution": { "value": 15, "unit": "MINUTES" } },
              { "source": { "property_id": 141870 }, "time": { "from": "$FROM_DATE", "until": "$UNTIL_DATE" }, "resolution": { "value": 15, "unit": "MINUTES" } }
            ]
          }
          EOF

          # Abfrage per PUT
          curl --request PUT \
            --url https://data-core.udp.senseering.io/api/elements/6/data/query \
            --header 'Accept: application/json' \
            --header "Authorization: $AUTH_HEADER" \
            --header 'Content-Type: application/json' \
            --data @payload.json \
            --output raw_data.json

      - name: Daten in flaches JSON für OpenDataSoft umwandeln
        run: |
          python -c '
          import json

          # Zuordnung der LAeq-Property-IDs
          property_ids = [141830, 141835, 141870]

          with open("raw_data.json", "r") as f:
              raw_data = json.load(f)

          flat_data = []

          if isinstance(raw_data, list):
              for idx, item in enumerate(raw_data):
                  if not isinstance(item, dict):
                      continue

                  prop_id = property_ids[idx] if idx < len(property_ids) else None
                  
                  data_obj = item.get("data", {})
                  if isinstance(data_obj, dict):
                      times = data_obj.get("time", [])
                      values = data_obj.get("value", [])

                      if isinstance(times, list) and isinstance(values, list):
                          for t, v in zip(times, values):
                              flat_data.append({
                                  "timestamp": t,
                                  "property_id": prop_id,
                                  "value": v
                              })

          with open("live_data.json", "w") as f:
              json.dump(flat_data, f, indent=2)
          '

      - name: Datei im Repository aktualisieren
        run: |
          git config user.name "GitHub Action"
          git config user.email "action@github.com"
          git add live_data.json
          git commit -m "Auto-Update Lärmdaten (nur LAeq, 14 Tage, 15-Min-Intervalle)" || exit 0
          git push
